{
  "manifest_version": 3,
  "name": "AegisSOC Edge Interceptor",
  "version": "2.6.1",
  "description": "Zero-execution neural binary (ResNet-50 + Grad-CAM), PDF active-payload, & steganography triage for WhatsApp Web and Gmail.",
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://teem5002-aegissoc-backend.hf.space/*",
    "https://aegissoc.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*"
      ],
      "js": [
        "injector.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://mail.google.com/*",
        "https://aegissoc.vercel.app/*",
        "https://threat-detection-ui.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
